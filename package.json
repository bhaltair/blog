{
  "scripts": {
    "start:docsify": "docsify serve docs && browser-sync start --server --files ’**/*.md‘",
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs"
  },
  "docsify": {
    "config": {
      "basePath": "https://bhaltair.github.io/blog/",
      "loadSidebar": true,
      "loadNavbar": true
    }
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "^2.0.0-rc.28",
    "@vuepress/plugin-google-analytics": "^2.0.0-rc.128",
    "@vuepress/theme-default": "^2.0.0-rc.128",
    "cz-customizable": "^6.2.0",
    "sass-embedded": "^1.99.0",
    "vuepress": "^2.0.0-rc.28"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.js"
    }
  },
  "packageManager": "pnpm@10.4.0"
}

{
  "scripts": {
    "start": "docsify serve src",
    "build": "dumi build",
    "start:dumi": "dumi dev",
    "dev": "browser-sync start --server --files ’**/*.md‘",
    "docs:dev": "vuepress dev src",
    "docs:build": "vuepress build src"    
  },
  "docsify": {
    "config": {
      "basePath": "https://www.bhaltair.top/",
      "loadSidebar": true,
      "loadNavbar": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "cz-customizable": "^6.2.0",
    "dumi": "^1.0.31",
    "vuepress": "^1.5.2"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.js"
    }
  }
}
